@import "tailwindcss";

/* Scan these files for Tailwind classes */
@source "../index.html";
@source "../assets/js";

@theme {
  --font-sans: "Manrope", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
}

/* ---------- Animations ---------- */
@keyframes fadeInUp {
  0% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}
@keyframes popIn {
  0% { opacity: 0; transform: scale(0); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes currentPulse {
  0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.45); }
  70%, 100% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
}

/* Elements fade up once they scroll into view (main.js adds .is-visible) */
.reveal { animation: fadeInUp 0.6s ease-out backwards paused; }
.reveal-pop { animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.9s backwards paused; }
.reveal.is-visible,
.reveal-pop.is-visible { animation-play-state: running; }

.pulse-ring { animation: currentPulse 2.4s ease-out infinite; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
  html { scroll-behavior: auto; }
}

/* ---------- Layout helpers ---------- */
html { scroll-padding-top: 72px; }

/* Active nav link (set by main.js) */
.nav-link.is-active { color: var(--color-emerald-400); border-color: var(--color-emerald-400); }

/* Technology badges — set the brand colour per badge with style="--c:#hex" */
.tech-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.75rem;
  border-radius: 5px;
  border: 1px solid color-mix(in srgb, var(--c, #10b981) 30%, white);
  background: color-mix(in srgb, var(--c, #10b981) 7%, white);
  color: color-mix(in srgb, var(--c, #10b981) 75%, black);
  font-size: 0.875rem;
  font-weight: 500;
  line-height: 1.25rem;
}

/* Hero code backdrop */
.code-backdrop {
  background:
    radial-gradient(ellipse at 70% 40%, rgba(16, 185, 129, 0.12), transparent 60%),
    #0b0b0d;
}
.code-backdrop pre { white-space: pre; transform: perspective(1200px) rotateY(-6deg); transform-origin: left center; }

/* About photo dot-grid accent */
.about-dots {
  background-image: radial-gradient(var(--color-emerald-500) 1.5px, transparent 1.5px);
  background-size: 14px 14px;
  opacity: 0.35;
}

/* Article cover gradients — set --c1 / --c2 per card */
.article-cover { background: linear-gradient(135deg, var(--c1, #064e3b), var(--c2, #10b981)); }
